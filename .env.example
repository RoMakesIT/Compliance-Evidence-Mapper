# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit secrets.

# ---------------------------------------------------------------------------
# Local Supabase (default — recommended for development)
# ---------------------------------------------------------------------------
# `supabase start` runs the full Supabase stack in Docker on these ports.
# The local anon key below is the standard development key shipped by the
# Supabase CLI. It is safe to commit to .env.example. Do not use in prod.
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsImtpZCI6ImxvY2FsIiwidHlwIjoiSldUIn0.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"

# ---------------------------------------------------------------------------
# To target a cloud Supabase project instead, comment out the lines above
# and uncomment / fill in the lines below:
# ---------------------------------------------------------------------------
# VITE_SUPABASE_URL="https://YOUR-PROJECT-ID.supabase.co"
# VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
